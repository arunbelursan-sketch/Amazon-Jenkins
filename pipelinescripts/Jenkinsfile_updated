pipeline {
    agent any
    environment {
        // Use PATH+EXTRA to append to PATH properly
        PATH = "/usr/bin:/bin:/opt/homebrew/bin"
    }
    stages {
        stage('pull scm git ') {
            steps {
                git branch: 'feature1', url: 'https://github.com/arunbelursan-sketch/Amazon-Jenkins.git'
            }
        }
        stage('compile ') {
            steps {
                sh 'mvn compile'
            }
        }
        stage('build') {
            steps {
                 sh 'mvn clean install'
            }
        }
    }  // <-- Close the 'stages' block here
 
    post {  // <-- 'post' should be at the same level as 'stages'
        success {
            echo 'Build success 1'
        }
        failure {
            echo 'Failure in the build'
        }
    }
}  // <-- Close the 'pipeline' block here
